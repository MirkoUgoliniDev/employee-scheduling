# Maven
target/

# IDE
.idea/
*.iml
*.swp
*.swo
nbproject/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# SQLite transient files
*.db-journal
*.db-wal
*.db-shm

# Local databases and DB Browser configuration. The one exception is
# employee_scheduling.db: it is the DEMONSTRATION database, published on purpose, with
# invented names and emails and no credentials (see CLAUDE.md, "Anonymization").
# Every other .db in this directory is working material and stays out.
databases/*.db
!databases/employee_scheduling.db
databases/*.sqbpro

# Automatic database backups
databases/backups/

# Manual database snapshots and backup settings written at runtime
databases/*_pre-*.db
databases/backup-settings.properties
databases/app.log*

# Environment (local credentials — never commit)
.env
.runtime-backups/
raspberry-setup.zip
raspberry-setup.tar.gz
.public-export/

# Claude Code: the agent and skill definitions travel with the repository, because they
# describe how to work on it. Machine-specific state and granted permissions do not.
.claude/*
!.claude/agents/
!.claude/skills/

dist/
databases/standalone-test.db
databases/*pre-standalone*

employee-scheduling-datalarge_data.db

# Python cache of the installation wizard
__pycache__/
*.pyc

# Local configuration of the coding assistants: it belongs to the developer's machine,
# not to the project. .kilo in particular holds thousands of cache files, and without
# this rule an absent-minded "git add -A" would drag every one of them in.
.kilo/
.agents/

# Personal working diary: useful to the developer, noise to whoever reads the
# repository. It stays on disk, outside version control.
MEMORY.md

# Audit handoff: describes unfixed security findings, so it must not reach the
# public repository before those findings are closed.
HANDOFF.md
